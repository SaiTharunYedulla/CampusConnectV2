generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum AcademicYear {
  FIRST_YEAR
  SECOND_YEAR
  THIRD_YEAR
  FOURTH_YEAR
}

enum PostStatus {
  DRAFT
  PENDING_REVIEW
  REVISION_REQUESTED
  APPROVED
  REJECTED
}

enum ReviewAction {
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum AchievementPosition {
  FIRST
  SECOND
  THIRD
  TOP_5
  TOP_10
  FINALIST
  PARTICIPANT
}

// ─── TABLES ─────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  student               Student?
  teacher               Teacher?
  verificationDocuments AccountVerificationDocument[]
  refreshTokens         RefreshToken[]
  auditLogs             AuditLog[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Department {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  students Student[]
  teachers Teacher[]

  @@map("departments")
}

model Student {
  id           String        @id @default(uuid())
  userId       String        @unique @map("user_id")
  departmentId String?       @map("department_id")
  academicYear AcademicYear? @map("academic_year")
  username     String        @unique
  firstName    String        @map("first_name")
  lastName     String        @map("last_name")
  bio          String?
  profilePhoto String?       @map("profile_photo")
  education    String?
  socialLinks  Json?         @map("social_links")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  posts      Post[]
  skills     StudentSkill[]
  upvotes    PostUpvote[]
  badges     StudentBadge[]

  @@index([departmentId])
  @@map("students")
}

model Teacher {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  departmentId String?  @map("department_id")
  designation  String?
  employeeId   String?  @unique @map("employee_id")
  username     String   @unique
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  bio          String?
  profilePhoto String?  @map("profile_photo")
  expertise    String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user          User        @relation(fields: [userId], references: [id])
  department    Department? @relation(fields: [departmentId], references: [id])
  reviews       Review[]
  verifiedPosts Post[]      @relation("VerifiedBy")

  @@index([departmentId])
  @@map("teachers")
}

model AccountVerificationDocument {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  documentType String   @map("document_type")
  fileName     String   @map("file_name")
  fileType     String   @map("file_type")
  fileSize     BigInt   @map("file_size")
  storageKey   String   @map("storage_key")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("account_verification_documents")
}

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  students StudentSkill[]
  posts    PostSkill[]

  @@map("skills")
}

model StudentSkill {
  studentId String @map("student_id")
  skillId   String @map("skill_id")

  student Student @relation(fields: [studentId], references: [id])
  skill   Skill   @relation(fields: [skillId], references: [id])

  @@id([studentId, skillId])
  @@map("student_skills")
}

model AchievementCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  posts Post[]

  @@map("achievement_categories")
}

model Domain {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  posts Post[]

  @@map("domains")
}

model Post {
  id              String              @id @default(uuid())
  studentId       String              @map("student_id")
  categoryId      String?             @map("category_id")
  domainId        String?             @map("domain_id")
  title           String
  description     String
  achievementDate DateTime            @map("achievement_date") @db.Date
  position        AchievementPosition?
  status          PostStatus          @default(DRAFT)
  score           Decimal?            @db.Decimal(5, 2)
  teacherFeedback String?             @map("teacher_feedback")
  verifiedById    String?             @map("verified_by")
  verifiedAt      DateTime?           @map("verified_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  student    Student              @relation(fields: [studentId], references: [id])
  category   AchievementCategory? @relation(fields: [categoryId], references: [id])
  domain     Domain?              @relation(fields: [domainId], references: [id])
  verifiedBy Teacher?             @relation("VerifiedBy", fields: [verifiedById], references: [id])
  media      PostMedia[]
  skills     PostSkill[]
  reviews    Review[]
  upvotes    PostUpvote[]

  @@index([studentId])
  @@index([status])
  @@index([categoryId])
  @@index([domainId])
  @@index([createdAt])
  @@map("posts")
}

model PostMedia {
  id         String   @id @default(uuid())
  postId     String   @map("post_id")
  fileName   String   @map("file_name")
  fileType   String   @map("file_type")
  fileSize   BigInt   @map("file_size")
  storageKey String   @map("storage_key")
  createdAt  DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("post_media")
}

model PostSkill {
  postId  String @map("post_id")
  skillId String @map("skill_id")

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id])

  @@id([postId, skillId])
  @@map("post_skills")
}

model Review {
  id        String       @id @default(uuid())
  postId    String       @map("post_id")
  teacherId String       @map("teacher_id")
  action    ReviewAction
  score     Decimal?     @db.Decimal(5, 2)
  feedback  String?
  createdAt DateTime     @default(now()) @map("created_at")

  post    Post    @relation(fields: [postId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@index([postId])
  @@index([teacherId])
  @@map("reviews")
}

model PostUpvote {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  studentId String   @map("student_id")
  createdAt DateTime @default(now()) @map("created_at")

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id])

  @@unique([postId, studentId])
  @@index([postId])
  @@index([studentId])
  @@map("post_upvotes")
}

model Badge {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  icon        String
  criteria    Json
  createdAt   DateTime @default(now()) @map("created_at")

  students StudentBadge[]

  @@map("badges")
}

model StudentBadge {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  badgeId   String   @map("badge_id")
  earnedAt  DateTime @default(now()) @map("earned_at")

  student Student @relation(fields: [studentId], references: [id])
  badge   Badge   @relation(fields: [badgeId], references: [id])

  @@unique([studentId, badgeId])
  @@map("student_badges")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String   @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorUserId], references: [id])

  @@map("audit_logs")
}
